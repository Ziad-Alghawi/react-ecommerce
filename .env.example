# Copy to .env.local. Vite reads this at build time.
# Leave empty when the frontend and API share one URL (local dev, or one Render service).
# Set it to the backend URL when they are hosted separately, with no trailing slash.
VITE_API_URL=

# Optional user accounts with Supabase Auth: the Project URL and the publishable key
# (sb_publishable_...) from Project Settings > API Keys. Both are safe to ship to the
# browser; never put the secret key here. Leave them empty for guest-only mode, which
# hides the login and keeps a cart per browser. Set SUPABASE_URL for the backend too.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
