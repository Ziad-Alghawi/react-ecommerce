# Set these in your host's dashboard. The server reads real environment
# variables; to use this file locally run: node --env-file=.env server.js

# Port for the server. Hosts like Render set this for you.
PORT=3000

# Frontend origins allowed to call the API, comma-separated, no trailing slash.
# Only needed when the frontend is on a different domain.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string, for example the Supabase Session pooler URL
# (Connect > Session pooler). SSL is always on, so leave out ?sslmode.
# Without it, the app uses a local SQLite file.
DATABASE_URL=

# Optional database from separate settings, used when DATABASE_URL is empty.
# DB_TYPE=postgres
# RDS_HOSTNAME=
# RDS_PORT=
# RDS_DB_NAME=
# RDS_USERNAME=
# RDS_PASSWORD=
