# Copy to .env for local settings, which the server reads on startup (restart it
# after a change). On a host, set real environment variables instead; they win over the file.

# Port for the server. Hosts like Render set this for you.
PORT=3000

# Frontend origins allowed to call the API, comma-separated, no trailing slash.
# Only needed when the frontend is on a different domain.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string, for example the Supabase Session pooler URL
# (Connect > Session pooler). SSL is always on, so leave out ?sslmode.
# Without it, the app uses a local SQLite file.
DATABASE_URL=

# Supabase project URL, the same as VITE_SUPABASE_URL in the frontend. Login tokens are
# checked against the project's public signing keys, so no secret is needed. Without it,
# accounts are off: requests with a token get 401 and everyone shops as a guest.
SUPABASE_URL=

# Supabase user IDs of the admins, comma-separated (Authentication > Users > User UID in the
# Supabase dashboard). They get the admin page to add, edit and delete products. Being an admin
# is only ever decided from a verified login token. Leave it empty for no admins.
ADMIN_USER_IDS=

# Optional card payment with Stripe Checkout, in test mode. The secret key (sk_test_...) is under
# Developers > API keys in the Stripe Dashboard. Only a test key turns card payment on; without
# one, checkout only offers paying on delivery.
STRIPE_SECRET_KEY=

# Signing secret (whsec_...) of the webhook endpoint for /api/stripe/webhook, from Developers >
# Webhooks or from `stripe listen`. Optional locally, where the success page creates the order.
STRIPE_WEBHOOK_SECRET=

# The demo products are restocked once a day: those with fewer than 5 left go back to their starting
# stock. Set to false to turn it off, for example for a store with real stock. On when empty.
DEMO_RESTOCK=

# Optional database from separate settings, used when DATABASE_URL is empty.
# DB_TYPE=postgres
# RDS_HOSTNAME=
# RDS_PORT=
# RDS_DB_NAME=
# RDS_USERNAME=
# RDS_PASSWORD=
